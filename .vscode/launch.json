{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Solar overview — Browser preview",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "debug",
      "toolArgs": ["--web-hostname", "127.0.0.1"]
    },
    {
      "name": "Solar overview — Android / iPhone",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "flutterMode": "debug"
    }
  ]
}
